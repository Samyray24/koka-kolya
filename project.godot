; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited manually.

config_version=5

[application]

config/name="Кока-Коля"
config/version="1.0.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LogManager="*res://scripts/core/log_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
InputManager="*res://scripts/core/input_manager.gd"
NoiseManager="*res://scripts/ai/noise_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"
EnvironmentManager="*res://scripts/core/environment_manager.gd"
VoiceManager="*res://scripts/core/voice_manager.gd"
CyberdeckManager="*res://scripts/core/cyberdeck_manager.gd"
ThreatManager="*res://scripts/core/threat_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

