text = "🛠️ 2. Арсенал инструментов и взлом"

[node name="Txt" type="Label" parent="Center/Panel/Margin/VBox/TabContainer/TabGuide/Scroll/VBoxGuide/Card2/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
text = "• [1] Руки: переноска тяжестей, физические манипуляции, броски.
• [2] Шоковая дубинка: бесшумно оглушает патрульных роботов и охрану на 8 секунд.
• [3] Пеномет: распыляет пену для тушения огня и блокировки камер.
• [4] Кибер-дека: дистанционный взлом терминалов ворот, замков и систем завода."
autowrap_mode = 2

